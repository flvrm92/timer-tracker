# Node.js dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# Build directories
dist/
out/
build/

# Electron files
*.asar
*.asar.unpacked/

# User-specific files
*.local
.env
*.env
.env.local
.env.production.local
.env.development.local

# IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Misc
electron-builder.yaml
*.bak
*.orig

# Database
/**/*.db

pbis/**/*

coverage/**/*

# Generated MSIX manifest (rendered from packaging/Package.appxmanifest.template)
packaging/Package.appxmanifest

# Signing certificates and private keys - never commit.
# scripts/sign-local.ps1 exports to a temp path outside the repo, but a stray key
# must not become committable just because it landed in the tree.
*.pfx
*.cer
*.p12
*.pem
*.key
*.snk

# Packaged app bundles. out/ already covers the normal build path; these catch a
# package copied elsewhere in the tree.
*.msix
*.msixbundle
*.appx
*.appxbundle
*.appxupload

# Real Partner Center identity. packaging/identity.json holds sideload-only
# placeholders and stays tracked; the real values go here, and never get committed.
packaging/identity.local.json

# Internal phase reports - kept on disk, out of the repo.
# The leading hash must be escaped or the whole line is read as a comment.
/\#specs/
